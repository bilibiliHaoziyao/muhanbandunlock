<Page
    x:Class="MuHanBandUnlock.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF121216">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="24,32,24,32">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="{StaticResource AccentBrush}" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0">
                    <FontIcon Glyph="&#xE785;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="慕寒手环解锁" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="MuHan Band Unlock · 忘记密码？一键找回" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource WarnBgBrush}"
                    BorderBrush="{StaticResource WarnBorderBrush}"
                    BorderThickness="2" CornerRadius="14" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="免责声明 · 使用前请阅读" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="本工具是用于解锁忘记密码的小米手环的。"
                               FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" LineHeight="22">
                        <Run Text="· 本工具仅供个人解锁自己拥有的设备使用，请勿用于他人设备或任何非法用途。"/>
                        <LineBreak/>
                        <Run Text="· 本工具为第三方开源工具，与小米公司无任何关联，小米、Mi Band 为其各自所有者的商标。"/>
                        <LineBreak/>
                        <Run Text="· 解锁操作会重置手环密码，可能清除手环上的数据；使用本工具所产生的任何后果由使用者自行承担。"/>
                        <LineBreak/>
                        <Run Text="· 继续使用即表示你已阅读并同意以上条款。"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="设备信息" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="MAC 地址" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="MacInput"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 PlaceholderText="例如 AA:BB:CC:DD:EE:FF（支持 - . 空格 等分隔符）"
                                 InputScope="AlphanumericLowerHollowLatin"
                                 TextChanged="Input_TextChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="序列号 SN" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="SnInput"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 PlaceholderText="在小米运动 App 或手环包装盒上查找"
                                 InputScope="AlphanumericLowerHollowLatin"
                                 TextChanged="Input_TextChanged"/>
                    </StackPanel>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="新版算法" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="S5 / 10 Pro 及更新机型请开启" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="NewAlgorithmToggle"
                                          Grid.Column="1"
                                          MinWidth="88" MinHeight="44"
                                          OnContent="开" OffContent="关"
                                          Toggled="Algorithm_Toggled"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Button x:Name="GenerateButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,20"
                    Click="GenerateButton_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="White" Margin="0,0,10,0"/>
                    <TextBlock Text="生成解锁码" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
            </Button>

            <Border x:Name="ResultCard"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,20"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="#FF5FD38A" Margin="0,0,10,0"/>
                        <TextBlock Text="解锁码" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <Border Background="#FF101418" CornerRadius="12" Padding="20,16" Margin="0,0,0,12">
                        <TextBlock x:Name="ResultText"
                                   FontSize="36" FontWeight="Bold"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrushLight}"
                                   Text="----------"/>
                    </Border>
                    <TextBlock x:Name="ResultHint"
                               Text="在手环密码输入界面依次输入以上 10 位数字即可解锁。"
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="CopyButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="复制解锁码" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="ErrorCard"
                    Background="{StaticResource WarnBgBrush}"
                    BorderBrush="{StaticResource WarnBorderBrush}"
                    BorderThickness="1.5" CornerRadius="12" Padding="16"
                    Margin="0,0,0,20"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ErrorText"
                               FontSize="15" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="算法移植自 leset0ng/ab-unlockcode（MIT License）· 仅供学习与个人使用"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</Page>
